            "lang": "en",
            "text": "Is there something you have always wanted to know about cats, big or small? Tell us below."
          },
          {
            "lang": "pt",
            "text": "Existe algo que você sempre quis saber sobre os felinos, grandes ou pequenos? Conte para nós abaixo."
          }
        ],
        "items": [
          {
            "key": "curiosity",
            "type": "text-line",
            "label": [
              {
                "lang": "en",
                "text": "What would you like to know about felines?"
              },
              {
                "lang": "pt",
                "text": "O que você gostaria de saber sobre os felinos?"
              }
            ],
            "required": true
          }
        ]
      }
    }
