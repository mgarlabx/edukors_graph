{
  "$schema": "https://edukors.org/graph/schema/v1/",
  "info": {
    "course-id": "6d888bac-4149-4e0a-a990-8db9c0830206",
    "source-language": "en",
    "other-languages": [
      "pt"
    ],
    "title": [
      {
        "lang": "en",
        "text": "Cats of the World - scripts"
      },
      {
        "lang": "pt",
        "text": "Felinos do Mundo - scripts"
      }
    ],
    "author": "edukors.org",
    "version": "1.0.0",
    "date": "2026-10-01",
    "start": "sh4"
  },
  "nodes": [
    {
      "id": "sh4",
      "type": "static-html",
      "section": 1,
      "position": {
        "x": 12,
        "y": 174
      },
      "title": [
        {
          "lang": "en",
          "text": "Interactive chart: lynx and hares"
        },
        {
          "lang": "pt",
          "text": "Gráfico interativo: linces e lebres"
        }
      ],
      "content": {
        "item": [
          {
            "lang": "en",
            "text": "<div style=\"font-family:system-ui,-apple-system,sans-serif;max-width:720px;margin:auto;color:#222\">\n<h3 style=\"margin:0 0 6px\">The lynx and the snowshoe hare</h3>\n<p style=\"margin:0 0 10px\">In the forests of Canada, the number of Canada lynx rises and falls in a cycle of about 10 years, following the snowshoe hare, its main prey. Fur-trading records kept for over a century show it clearly: when hares are plentiful, lynx raise more kittens; then the many lynx eat the hares down, and with little food the lynx decline too, letting the hares recover. The chart below uses a classic predator–prey model (Lotka–Volterra). Move the slider to change how efficient the lynx are as hunters and watch the curves and numbers change.</p>\n<svg id=\"ch\" viewBox=\"0 0 700 330\" style=\"width:100%;height:auto;background:#fcfbf8;border:1px solid #ddd;border-radius:8px\"></svg>\n<div style=\"margin:12px 0 4px\">Lynx hunting efficiency (chance of a catch per encounter, in the model): <b id=\"bv\"></b></div>\n<input type=\"range\" id=\"sl\" min=\"15\" max=\"60\" step=\"1\" value=\"30\" style=\"width:100%;accent-color:#3d6e9e\">\n<div style=\"display:flex;justify-content:space-between;font-size:12px;color:#777\"><span>clumsy hunters</span><span>expert hunters</span></div>\n<div id=\"stats\" style=\"display:flex;gap:8px;flex-wrap:wrap;margin-top:10px\"></div>\n</div>\n<script>\n(function(){\nvar A=0.6,C=0.6,D=0.0075,H0=50,L0=15,T=60,dt=0.02;\nvar sl=document.getElementById('sl'),svg=document.getElementById('ch'),bv=document.getElementById('bv'),st=document.getElementById('stats');\nvar W=700,HH=330,ml=56,mr=56,mt=20,mb=44,PW=W-ml-mr,PH=HH-mt-mb;\nfunction sim(b){var h=H0,l=L0,o=[[0,h,l]];function f(h,l){return [A*h-b*h*l,D*h*l-C*l];}\n var n=Math.round(T/dt);for(var i=1;i<=n;i++){var k1=f(h,l),k2=f(h+dt/2*k1[0],l+dt/2*k1[1]),k3=f(h+dt/2*k2[0],l+dt/2*k2[1]),k4=f(h+dt*k3[0],l+dt*k3[1]);\n h+=dt/6*(k1[0]+2*k2[0]+2*k3[0]+k4[0]);l+=dt/6*(k1[1]+2*k2[1]+2*k3[1]+k4[1]);if(i%5===0)o.push([i*dt,h,l]);}return o;}\nfunction nice(v){var p=Math.pow(10,Math.floor(Math.log(v)/Math.LN10)),f=v/p;return (f<=1?1:f<=2?2:f<=2.5?2.5:f<=5?5:10)*p;}\nfunction fmt(v){return Math.round(v).toLocaleString('en');}\nfunction card(label,val,col){return '<div style=\"flex:1;min-width:120px;background:#f5f0e8;border-radius:8px;padding:8px 10px\"><div style=\"font-size:12px;color:#666\">'+label+'</div><div style=\"font-size:18px;font-weight:600;color:'+col+'\">'+val+'</div></div>';}\nfunction draw(){\n var b=sl.value/1000;bv.textContent=(sl.value/10).toFixed(1)+'%';\n var d=sim(b),mxH=0,mxL=0,mnH=1e9,mnL=1e9;\n d.forEach(function(p){mxH=Math.max(mxH,p[1]);mxL=Math.max(mxL,p[2]);mnH=Math.min(mnH,p[1]);mnL=Math.min(mnL,p[2]);});\n var yh=nice(mxH*1.05),yl=nice(mxL*1.05);\n function X(t){return ml+t/T*PW;}function YH(v){return mt+PH-v/yh*PH;}function YL(v){return mt+PH-v/yl*PH;}\n var s='';\n for(var i=0;i<=5;i++){var y=mt+PH*i/5;\n  s+='<line x1=\"'+ml+'\" x2=\"'+(ml+PW)+'\" y1=\"'+y+'\" y2=\"'+y+'\" stroke=\"#e6e6e6\"/>';\n  s+='<text x=\"'+(ml-6)+'\" y=\"'+(y+4)+'\" text-anchor=\"end\" font-size=\"11\" fill=\"#a0612b\">'+fmt(yh*(5-i)/5)+'</text>';\n  s+='<text x=\"'+(ml+PW+6)+'\" y=\"'+(y+4)+'\" font-size=\"11\" fill=\"#3d6e9e\">'+fmt(yl*(5-i)/5)+'</text>';}\n for(var t=0;t<=T;t+=10){var x=X(t);s+='<line x1=\"'+x+'\" x2=\"'+x+'\" y1=\"'+mt+'\" y2=\"'+(mt+PH)+'\" stroke=\"#f0f0f0\"/><text x=\"'+x+'\" y=\"'+(mt+PH+16)+'\" text-anchor=\"middle\" font-size=\"11\" fill=\"#555\">'+t+'</text>';}\n s+='<text x=\"'+(ml+PW/2)+'\" y=\"'+(HH-6)+'\" text-anchor=\"middle\" font-size=\"12\" fill=\"#333\">Years</text>';\n s+='<text transform=\"translate(14,'+(mt+PH/2)+') rotate(-90)\" text-anchor=\"middle\" font-size=\"12\" fill=\"#a0612b\">Hares (thousands)</text>';\n s+='<text transform=\"translate('+(W-12)+','+(mt+PH/2)+') rotate(90)\" text-anchor=\"middle\" font-size=\"12\" fill=\"#3d6e9e\">Lynx (hundreds)</text>';\n var pH='',pL='';d.forEach(function(p,i){pH+=(i?'L':'M')+X(p[0]).toFixed(1)+' '+YH(p[1]).toFixed(1);pL+=(i?'L':'M')+X(p[0]).toFixed(1)+' '+YL(p[2]).toFixed(1);});\n s+='<path d=\"'+pH+'\" fill=\"none\" stroke=\"#c97b2e\" stroke-width=\"2.5\"/><path d=\"'+pL+'\" fill=\"none\" stroke=\"#3d6e9e\" stroke-width=\"2.5\"/>';\n s+='<rect x=\"'+(ml+10)+'\" y=\"'+(mt+6)+'\" width=\"160\" height=\"44\" rx=\"5\" fill=\"#fff\" opacity=\"0.9\" stroke=\"#ddd\"/>';\n s+='<line x1=\"'+(ml+18)+'\" x2=\"'+(ml+40)+'\" y1=\"'+(mt+21)+'\" y2=\"'+(mt+21)+'\" stroke=\"#c97b2e\" stroke-width=\"3\"/><text x=\"'+(ml+46)+'\" y=\"'+(mt+25)+'\" font-size=\"12\">Snowshoe hare</text>';\n s+='<line x1=\"'+(ml+18)+'\" x2=\"'+(ml+40)+'\" y1=\"'+(mt+39)+'\" y2=\"'+(mt+39)+'\" stroke=\"#3d6e9e\" stroke-width=\"3\"/><text x=\"'+(ml+46)+'\" y=\"'+(mt+43)+'\" font-size=\"12\">Canada lynx</text>';\n svg.innerHTML=s;\n var peaks=[];for(var j=1;j<d.length-1;j++){if(d[j][1]>d[j-1][1]&&d[j][1]>=d[j+1][1])peaks.push(d[j][0]);}\n var per=peaks.length>1?((peaks[peaks.length-1]-peaks[0])/(peaks.length-1)).toFixed(1)+' years':'—';\n st.innerHTML=card('Hare peak',fmt(mxH*1000),'#a0612b')+card('Hare low',fmt(mnH*1000),'#a0612b')+card('Lynx peak',fmt(mxL*100),'#3d6e9e')+card('Lynx low',fmt(mnL*100),'#3d6e9e')+card('Cycle length',per,'#444')+card('Hare boom ÷ bust','×'+(mxH/mnH).toFixed(1),'#444');\n}\nsl.addEventListener('input',draw);draw();\n})();\n</script>"
          },
          {
            "lang": "pt",
            "text": "<div style=\"font-family:system-ui,-apple-system,sans-serif;max-width:720px;margin:auto;color:#222\">\n<h3 style=\"margin:0 0 6px\">O lince e a lebre-americana</h3>\n<p style=\"margin:0 0 10px\">Nas florestas do Canadá, o número de linces-do-canadá sobe e desce num ciclo de cerca de 10 anos, acompanhando a lebre-americana, sua principal presa. Registros do comércio de peles mantidos por mais de um século mostram isso com clareza: quando as lebres são abundantes, os linces criam mais filhotes; depois, os muitos linces reduzem a população de lebres e, com pouca comida, os linces também diminuem, permitindo que as lebres se recuperem. O gráfico abaixo usa um modelo clássico de predador e presa (Lotka–Volterra). Mova a barra para mudar a eficiência dos linces como caçadores e veja as curvas e os números mudarem.</p>\n<svg id=\"ch\" viewBox=\"0 0 700 330\" style=\"width:100%;height:auto;background:#fcfbf8;border:1px solid #ddd;border-radius:8px\"></svg>\n<div style=\"margin:12px 0 4px\">Eficiência de caça do lince (chance de captura por encontro, no modelo): <b id=\"bv\"></b></div>\n<input type=\"range\" id=\"sl\" min=\"15\" max=\"60\" step=\"1\" value=\"30\" style=\"width:100%;accent-color:#3d6e9e\">\n<div style=\"display:flex;justify-content:space-between;font-size:12px;color:#777\"><span>caçadores desajeitados</span><span>caçadores experientes</span></div>\n<div id=\"stats\" style=\"display:flex;gap:8px;flex-wrap:wrap;margin-top:10px\"></div>\n</div>\n<script>\n(function(){\nvar A=0.6,C=0.6,D=0.0075,H0=50,L0=15,T=60,dt=0.02;\nvar sl=document.getElementById('sl'),svg=document.getElementById('ch'),bv=document.getElementById('bv'),st=document.getElementById('stats');\nvar W=700,HH=330,ml=56,mr=56,mt=20,mb=44,PW=W-ml-mr,PH=HH-mt-mb;\nfunction sim(b){var h=H0,l=L0,o=[[0,h,l]];function f(h,l){return [A*h-b*h*l,D*h*l-C*l];}\n var n=Math.round(T/dt);for(var i=1;i<=n;i++){var k1=f(h,l),k2=f(h+dt/2*k1[0],l+dt/2*k1[1]),k3=f(h+dt/2*k2[0],l+dt/2*k2[1]),k4=f(h+dt*k3[0],l+dt*k3[1]);\n h+=dt/6*(k1[0]+2*k2[0]+2*k3[0]+k4[0]);l+=dt/6*(k1[1]+2*k2[1]+2*k3[1]+k4[1]);if(i%5===0)o.push([i*dt,h,l]);}return o;}\nfunction nice(v){var p=Math.pow(10,Math.floor(Math.log(v)/Math.LN10)),f=v/p;return (f<=1?1:f<=2?2:f<=2.5?2.5:f<=5?5:10)*p;}\nfunction fmt(v){return Math.round(v).toLocaleString('pt-BR');}\nfunction dec(v){return v.toFixed(1).replace('.',',');}\nfunction card(label,val,col){return '<div style=\"flex:1;min-width:120px;background:#f5f0e8;border-radius:8px;padding:8px 10px\"><div style=\"font-size:12px;color:#666\">'+label+'</div><div style=\"font-size:18px;font-weight:600;color:'+col+'\">'+val+'</div></div>';}\nfunction draw(){\n var b=sl.value/1000;bv.textContent=dec(sl.value/10)+'%';\n var d=sim(b),mxH=0,mxL=0,mnH=1e9,mnL=1e9;\n d.forEach(function(p){mxH=Math.max(mxH,p[1]);mxL=Math.max(mxL,p[2]);mnH=Math.min(mnH,p[1]);mnL=Math.min(mnL,p[2]);});\n var yh=nice(mxH*1.05),yl=nice(mxL*1.05);\n function X(t){return ml+t/T*PW;}function YH(v){return mt+PH-v/yh*PH;}function YL(v){return mt+PH-v/yl*PH;}\n var s='';\n for(var i=0;i<=5;i++){var y=mt+PH*i/5;\n  s+='<line x1=\"'+ml+'\" x2=\"'+(ml+PW)+'\" y1=\"'+y+'\" y2=\"'+y+'\" stroke=\"#e6e6e6\"/>';\n  s+='<text x=\"'+(ml-6)+'\" y=\"'+(y+4)+'\" text-anchor=\"end\" font-size=\"11\" fill=\"#a0612b\">'+fmt(yh*(5-i)/5)+'</text>';\n  s+='<text x=\"'+(ml+PW+6)+'\" y=\"'+(y+4)+'\" font-size=\"11\" fill=\"#3d6e9e\">'+fmt(yl*(5-i)/5)+'</text>';}\n for(var t=0;t<=T;t+=10){var x=X(t);s+='<line x1=\"'+x+'\" x2=\"'+x+'\" y1=\"'+mt+'\" y2=\"'+(mt+PH)+'\" stroke=\"#f0f0f0\"/><text x=\"'+x+'\" y=\"'+(mt+PH+16)+'\" text-anchor=\"middle\" font-size=\"11\" fill=\"#555\">'+t+'</text>';}\n s+='<text x=\"'+(ml+PW/2)+'\" y=\"'+(HH-6)+'\" text-anchor=\"middle\" font-size=\"12\" fill=\"#333\">Anos</text>';\n s+='<text transform=\"translate(14,'+(mt+PH/2)+') rotate(-90)\" text-anchor=\"middle\" font-size=\"12\" fill=\"#a0612b\">Lebres (milhares)</text>';\n s+='<text transform=\"translate('+(W-12)+','+(mt+PH/2)+') rotate(90)\" text-anchor=\"middle\" font-size=\"12\" fill=\"#3d6e9e\">Linces (centenas)</text>';\n var pH='',pL='';d.forEach(function(p,i){pH+=(i?'L':'M')+X(p[0]).toFixed(1)+' '+YH(p[1]).toFixed(1);pL+=(i?'L':'M')+X(p[0]).toFixed(1)+' '+YL(p[2]).toFixed(1);});\n s+='<path d=\"'+pH+'\" fill=\"none\" stroke=\"#c97b2e\" stroke-width=\"2.5\"/><path d=\"'+pL+'\" fill=\"none\" stroke=\"#3d6e9e\" stroke-width=\"2.5\"/>';\n s+='<rect x=\"'+(ml+10)+'\" y=\"'+(mt+6)+'\" width=\"160\" height=\"44\" rx=\"5\" fill=\"#fff\" opacity=\"0.9\" stroke=\"#ddd\"/>';\n s+='<line x1=\"'+(ml+18)+'\" x2=\"'+(ml+40)+'\" y1=\"'+(mt+21)+'\" y2=\"'+(mt+21)+'\" stroke=\"#c97b2e\" stroke-width=\"3\"/><text x=\"'+(ml+46)+'\" y=\"'+(mt+25)+'\" font-size=\"12\">Lebre-americana</text>';\n s+='<line x1=\"'+(ml+18)+'\" x2=\"'+(ml+40)+'\" y1=\"'+(mt+39)+'\" y2=\"'+(mt+39)+'\" stroke=\"#3d6e9e\" stroke-width=\"3\"/><text x=\"'+(ml+46)+'\" y=\"'+(mt+43)+'\" font-size=\"12\">Lince-do-canadá</text>';\n svg.innerHTML=s;\n var peaks=[];for(var j=1;j<d.length-1;j++){if(d[j][1]>d[j-1][1]&&d[j][1]>=d[j+1][1])peaks.push(d[j][0]);}\n var per=peaks.length>1?dec((peaks[peaks.length-1]-peaks[0])/(peaks.length-1))+' anos':'—';\n st.innerHTML=card('Pico de lebres',fmt(mxH*1000),'#a0612b')+card('Mínimo de lebres',fmt(mnH*1000),'#a0612b')+card('Pico de linces',fmt(mxL*100),'#3d6e9e')+card('Mínimo de linces',fmt(mnL*100),'#3d6e9e')+card('Duração do ciclo',per,'#444')+card('Lebres: pico ÷ mínimo','×'+dec(mxH/mnH),'#444');\n}\nsl.addEventListener('input',draw);draw();\n})();\n</script>"
          }
        ]
      }
    },
    {
      "id": "sh5",
      "type": "static-html",
      "section": 1,
      "position": {
        "x": 12,
        "y": 339
      },
      "title": [
        {
          "lang": "en",
          "text": "Animation: the cheetah's sprint"
        },
        {
          "lang": "pt",
          "text": "Animação: a corrida do guepardo"
        }
      ],
      "content": {
        "item": [
          {
            "lang": "en",
            "text": "<div style=\"font-family:system-ui,-apple-system,sans-serif;max-width:720px;margin:auto;color:#222\">\n<h3 style=\"margin:0 0 6px\">The cheetah's sprint</h3>\n<p style=\"margin:0 0 10px\">The cheetah is the fastest land animal: it can reach about 100 km/h, covering up to 7 metres in a single stride. But this speed costs a lot of energy and heat, so a chase lasts only 20 to 30 seconds, and afterwards the cheetah must rest. Choose a gait and keep an eye on the stamina bar.</p>\n<canvas id=\"cv\" style=\"width:100%;display:block;border-radius:10px;aspect-ratio:720/300\"></canvas>\n<div id=\"ctl\" style=\"display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px\">\n<button data-g=\"walk\">Walk</button><button data-g=\"trot\">Trot</button><button data-g=\"sprint\">Sprint</button>\n<span id=\"info\" style=\"margin-left:6px;font-size:14px;color:#a33\"></span>\n</div>\n</div>\n<style>#ctl button{padding:6px 16px;border:1px solid #b8862b;background:#fff7e6;color:#6b4a12;border-radius:6px;cursor:pointer;font-size:14px}#ctl button.on{background:#b8862b;color:#fff}#ctl button:disabled{opacity:.4;cursor:not-allowed}</style>\n<script>\n(function(){\nvar cv=document.getElementById('cv'),ctx=cv.getContext('2d'),W=720,H=300,dpr=window.devicePixelRatio||1;\ncv.width=W*dpr;cv.height=H*dpr;ctx.scale(dpr,dpr);\nvar G={walk:{kmh:5,px:70,cad:5,amp:.35,bob:1.5},trot:{kmh:20,px:220,cad:9,amp:.55,bob:3.5},sprint:{kmh:100,px:950,cad:17,amp:.95,bob:6}};\nvar gait='trot',cur={kmh:20,px:220,cad:9,amp:.55,bob:3.5},stamina=1,tired=false,off=0,ph=0,last=null,dust=[];\nvar seed=7;function rnd(){seed=seed*16807%2147483647;return seed/2147483647;}\nvar spots=[];while(spots.length<45){var sx=-58+rnd()*116,sy=-17+rnd()*30;if((sx/58)*(sx/58)+(sy/17)*(sy/17)<0.85)spots.push([sx,sy,1.4+rnd()*1.6]);}\nvar btns=document.querySelectorAll('#ctl button'),info=document.getElementById('info'),sprintBtn=document.querySelector('#ctl button[data-g=sprint]');\nfunction setG(g){if(g==='sprint'&&tired)return;gait=g;for(var i=0;i<btns.length;i++)btns[i].classList.toggle('on',btns[i].getAttribute('data-g')===g);}\nfor(var i=0;i<btns.length;i++)btns[i].onclick=function(){setG(this.getAttribute('data-g'));};\nsetG('trot');\nfunction acacia(x,y,s){ctx.strokeStyle='#6b4f2a';ctx.lineWidth=4*s;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x,y-38*s);ctx.lineTo(x-14*s,y-56*s);ctx.moveTo(x,y-38*s);ctx.lineTo(x+16*s,y-58*s);ctx.stroke();ctx.fillStyle='#5f7a3a';ctx.beginPath();ctx.ellipse(x,y-60*s,48*s,11*s,0,0,Math.PI*2);ctx.fill();}\nfunction hills(f,base,a1,a2,col){ctx.fillStyle=col;ctx.beginPath();ctx.moveTo(0,H);for(var x=0;x<=W;x+=8){var w=x+off*f;ctx.lineTo(x,base-a1*Math.sin(w/130)-a2*Math.sin(w/53));}ctx.lineTo(W,H);ctx.closePath();ctx.fill();}\nfunction leg(hx,hy,tu,tl,col,wu){ctx.strokeStyle=col;ctx.fillStyle=col;ctx.lineCap='round';var kx=hx+Math.sin(tu)*25,ky=hy+Math.cos(tu)*25,fx=kx+Math.sin(tl)*24,fy=ky+Math.cos(tl)*24;\n ctx.lineWidth=wu;ctx.beginPath();ctx.moveTo(hx,hy);ctx.lineTo(kx,ky);ctx.stroke();ctx.lineWidth=6;ctx.beginPath();ctx.moveTo(kx,ky);ctx.lineTo(fx,fy);ctx.stroke();ctx.beginPath();ctx.ellipse(fx+2,fy,5,3,0,0,Math.PI*2);ctx.fill();}\nfunction drawLeg(front,offp,a,shX,hpX,col,w){var s=Math.sin(ph+offp),c=Math.cos(ph+offp),bend=Math.max(0,c)*a*1.3,tu,tl;\n if(front){tu=a*s*0.8;tl=tu-bend;leg(shX,4,tu,tl,col,w);}else{tu=0.25+a*s*0.8;tl=tu-0.6-0.6*bend;leg(hpX,4,tu,tl,col,w);}}\nfunction frame(t){\n if(last===null)last=t;var dt=Math.min(0.05,(t-last)/1000);last=t;\n if(gait==='sprint'){stamina-=dt/8;if(stamina<=0){stamina=0;tired=true;setG('walk');}}\n else{stamina=Math.min(1,stamina+dt/(gait==='walk'?10:16));if(tired&&stamina>0.6)tired=false;}\n sprintBtn.disabled=tired;\n info.textContent=tired?'Overheated! The cheetah must rest before sprinting again.':(gait==='sprint'?'Full sprint: stamina is running out…':'');\n var tg=G[gait],k=Math.min(1,dt*2.5);for(var key in tg)cur[key]+=(tg[key]-cur[key])*k;\n off+=cur.px*dt;ph+=cur.cad*dt;\n var sky=ctx.createLinearGradient(0,0,0,240);sky.addColorStop(0,'#f6c77b');sky.addColorStop(1,'#fde9c4');ctx.fillStyle=sky;ctx.fillRect(0,0,W,H);\n ctx.fillStyle='#fff6d5';ctx.beginPath();ctx.arc(600,70,28,0,Math.PI*2);ctx.fill();\n hills(0.05,175,18,8,'#e0c193');hills(0.15,205,14,6,'#cfa96c');\n var span=1500,tr=[[120,1],[520,0.8],[900,1.15],[1250,0.9]];for(var i=0;i<tr.length;i++){var x=((tr[i][0]-off*0.4)%span+span)%span-100;acacia(x,230,tr[i][1]);}\n ctx.fillStyle='#d6b56a';ctx.fillRect(0,236,W,H-236);\n ctx.strokeStyle='#a5853d';ctx.lineWidth=2;var sp=38,st=-(off%sp);\n for(var gx=st;gx<W+sp;gx+=sp){var idx=Math.abs(Math.round((gx+off)/sp)),h=6+(idx*37%9),x2=gx+(idx*13%17),gy=252+(idx*7%4)*12;ctx.beginPath();ctx.moveTo(x2,gy);ctx.lineTo(x2-3,gy-h);ctx.moveTo(x2,gy);ctx.lineTo(x2,gy-h-2);ctx.moveTo(x2,gy);ctx.lineTo(x2+3,gy-h);ctx.stroke();}\n var cx=320;\n if(cur.px>400&&Math.random()<dt*40)dust.push({x:cx-50+Math.random()*90,y:238,r:3+Math.random()*4,l:0.6});\n for(var di=dust.length-1;di>=0;di--){var p=dust[di];p.x-=cur.px*dt*0.6;p.y-=12*dt;p.l-=dt;if(p.l<=0){dust.splice(di,1);continue;}ctx.fillStyle='rgba(160,130,80,'+(p.l*0.8)+')';ctx.beginPath();ctx.arc(p.x,p.y,p.r*(1.6-p.l),0,Math.PI*2);ctx.fill();}\n ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(cx,241,75,6,0,0,Math.PI*2);ctx.fill();\n var a=cur.amp,by=187-cur.bob*Math.abs(Math.sin(ph)),fl=(a-0.35)*12*Math.sin(ph),shX=40+fl,hpX=-40-fl,rx=56+fl;\n ctx.save();ctx.translate(cx,by);\n drawLeg(false,0.6,a,shX,hpX,'#b8892f',10);drawLeg(true,Math.PI+0.6,a,shX,hpX,'#b8892f',9);\n var tw=Math.sin(ph*0.5)*8;ctx.strokeStyle='#d9a843';ctx.lineWidth=6;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(hpX-10,-6);ctx.quadraticCurveTo(hpX-55,-24+tw,hpX-88,-2+tw*1.6);ctx.stroke();\n ctx.fillStyle='#222';ctx.beginPath();ctx.arc(hpX-88,-2+tw*1.6,4,0,Math.PI*2);ctx.fill();\n ctx.fillStyle='#e0ae4c';ctx.beginPath();ctx.ellipse(0,0,rx,18,0,0,Math.PI*2);ctx.fill();\n ctx.save();ctx.beginPath();ctx.ellipse(0,0,rx,18,0,0,Math.PI*2);ctx.clip();\n ctx.fillStyle='#f3dca5';ctx.beginPath();ctx.ellipse(0,12,rx-8,9,0,0,Math.PI*2);ctx.fill();\n ctx.fillStyle='#2b2118';for(var si=0;si<spots.length;si++){ctx.beginPath();ctx.arc(spots[si][0]*rx/56,spots[si][1],spots[si][2],0,Math.PI*2);ctx.fill();}\n ctx.restore();\n ctx.fillStyle='#e0ae4c';ctx.beginPath();ctx.ellipse(shX+12,-8,20,15,-0.4,0,Math.PI*2);ctx.fill();\n ctx.beginPath();ctx.arc(shX+38,-22,14,0,Math.PI*2);ctx.fill();\n ctx.fillStyle='#c99636';ctx.beginPath();ctx.moveTo(shX+29,-32);ctx.lineTo(shX+32,-44);ctx.lineTo(shX+39,-34);ctx.closePath();ctx.fill();\n ctx.fillStyle='#f3dca5';ctx.beginPath();ctx.ellipse(shX+49,-17,9,7,0,0,Math.PI*2);ctx.fill();\n ctx.fillStyle='#222';ctx.beginPath();ctx.arc(shX+43,-25,2.2,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(shX+57,-19,2.5,0,Math.PI*2);ctx.fill();\n ctx.strokeStyle='#222';ctx.lineWidth=1.8;ctx.beginPath();ctx.moveTo(shX+43,-23);ctx.quadraticCurveTo(shX+43,-16,shX+48,-11);ctx.stroke();\n drawLeg(false,0,a,shX,hpX,'#d9a843',11);drawLeg(true,Math.PI,a,shX,hpX,'#d9a843',9);\n ctx.restore();\n ctx.fillStyle='rgba(255,255,255,0.8)';ctx.fillRect(12,12,200,50);\n ctx.fillStyle='#333';ctx.font='bold 14px system-ui,sans-serif';ctx.fillText('Speed ≈ '+Math.round(cur.kmh)+' km/h',22,32);\n ctx.font='11px system-ui,sans-serif';ctx.fillText('Stamina',22,50);ctx.fillStyle='#ddd';ctx.fillRect(70,42,130,9);\n ctx.fillStyle=stamina>0.3?'#4a9a3c':'#d0452f';ctx.fillRect(70,42,130*stamina,9);\n requestAnimationFrame(frame);\n}\nrequestAnimationFrame(frame);\n})();\n</script>"
          },
          {
            "lang": "pt",
            "text": "<div style=\"font-family:system-ui,-apple-system,sans-serif;max-width:720px;margin:auto;color:#222\">\n<h3 style=\"margin:0 0 6px\">A corrida do guepardo</h3>\n<p style=\"margin:0 0 10px\">O guepardo é o animal terrestre mais rápido: pode chegar a cerca de 100 km/h, percorrendo até 7 metros numa única passada. Mas essa velocidade custa muita energia e calor, por isso uma perseguição dura só de 20 a 30 segundos, e depois o guepardo precisa descansar. Escolha um passo e fique de olho na barra de fôlego.</p>\n<canvas id=\"cv\" style=\"width:100%;display:block;border-radius:10px;aspect-ratio:720/300\"></canvas>\n<div id=\"ctl\" style=\"display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px\">\n<button data-g=\"walk\">Andar</button><button data-g=\"trot\">Trotar</button><button data-g=\"sprint\">Disparar</button>\n<span id=\"info\" style=\"margin-left:6px;font-size:14px;color:#a33\"></span>\n</div>\n</div>\n<style>#ctl button{padding:6px 16px;border:1px solid #b8862b;background:#fff7e6;color:#6b4a12;border-radius:6px;cursor:pointer;font-size:14px}#ctl button.on{background:#b8862b;color:#fff}#ctl button:disabled{opacity:.4;cursor:not-allowed}</style>\n<script>\n(function(){\nvar cv=document.getElementById('cv'),ctx=cv.getContext('2d'),W=720,H=300,dpr=window.devicePixelRatio||1;\ncv.width=W*dpr;cv.height=H*dpr;ctx.scale(dpr,dpr);\nvar G={walk:{kmh:5,px:70,cad:5,amp:.35,bob:1.5},trot:{kmh:20,px:220,cad:9,amp:.55,bob:3.5},sprint:{kmh:100,px:950,cad:17,amp:.95,bob:6}};\nvar gait='trot',cur={kmh:20,px:220,cad:9,amp:.55,bob:3.5},stamina=1,tired=false,off=0,ph=0,last=null,dust=[];\nvar seed=7;function rnd(){seed=seed*16807%2147483647;return seed/2147483647;}\nvar spots=[];while(spots.length<45){var sx=-58+rnd()*116,sy=-17+rnd()*30;if((sx/58)*(sx/58)+(sy/17)*(sy/17)<0.85)spots.push([sx,sy,1.4+rnd()*1.6]);}\nvar btns=document.querySelectorAll('#ctl button'),info=document.getElementById('info'),sprintBtn=document.querySelector('#ctl button[data-g=sprint]');\nfunction setG(g){if(g==='sprint'&&tired)return;gait=g;for(var i=0;i<btns.length;i++)btns[i].classList.toggle('on',btns[i].getAttribute('data-g')===g);}\nfor(var i=0;i<btns.length;i++)btns[i].onclick=function(){setG(this.getAttribute('data-g'));};\nsetG('trot');\nfunction acacia(x,y,s){ctx.strokeStyle='#6b4f2a';ctx.lineWidth=4*s;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x,y-38*s);ctx.lineTo(x-14*s,y-56*s);ctx.moveTo(x,y-38*s);ctx.lineTo(x+16*s,y-58*s);ctx.stroke();ctx.fillStyle='#5f7a3a';ctx.beginPath();ctx.ellipse(x,y-60*s,48*s,11*s,0,0,Math.PI*2);ctx.fill();}\nfunction hills(f,base,a1,a2,col){ctx.fillStyle=col;ctx.beginPath();ctx.moveTo(0,H);for(var x=0;x<=W;x+=8){var w=x+off*f;ctx.lineTo(x,base-a1*Math.sin(w/130)-a2*Math.sin(w/53));}ctx.lineTo(W,H);ctx.closePath();ctx.fill();}\nfunction leg(hx,hy,tu,tl,col,wu){ctx.strokeStyle=col;ctx.fillStyle=col;ctx.lineCap='round';var kx=hx+Math.sin(tu)*25,ky=hy+Math.cos(tu)*25,fx=kx+Math.sin(tl)*24,fy=ky+Math.cos(tl)*24;\n ctx.lineWidth=wu;ctx.beginPath();ctx.moveTo(hx,hy);ctx.lineTo(kx,ky);ctx.stroke();ctx.lineWidth=6;ctx.beginPath();ctx.moveTo(kx,ky);ctx.lineTo(fx,fy);ctx.stroke();ctx.beginPath();ctx.ellipse(fx+2,fy,5,3,0,0,Math.PI*2);ctx.fill();}\nfunction drawLeg(front,offp,a,shX,hpX,col,w){var s=Math.sin(ph+offp),c=Math.cos(ph+offp),bend=Math.max(0,c)*a*1.3,tu,tl;\n if(front){tu=a*s*0.8;tl=tu-bend;leg(shX,4,tu,tl,col,w);}else{tu=0.25+a*s*0.8;tl=tu-0.6-0.6*bend;leg(hpX,4,tu,tl,col,w);}}\nfunction frame(t){\n if(last===null)last=t;var dt=Math.min(0.05,(t-last)/1000);last=t;\n if(gait==='sprint'){stamina-=dt/8;if(stamina<=0){stamina=0;tired=true;setG('walk');}}\n else{stamina=Math.min(1,stamina+dt/(gait==='walk'?10:16));if(tired&&stamina>0.6)tired=false;}\n sprintBtn.disabled=tired;\n info.textContent=tired?'Superaquecido! O guepardo precisa descansar antes de disparar de novo.':(gait==='sprint'?'Velocidade máxima: o fôlego está acabando…':'');\n var tg=G[gait],k=Math.min(1,dt*2.5);for(var key in tg)cur[key]+=(tg[key]-cur[key])*k;\n off+=cur.px*dt;ph+=cur.cad*dt;\n var sky=ctx.createLinearGradient(0,0,0,240);sky.addColorStop(0,'#f6c77b');sky.addColorStop(1,'#fde9c4');ctx.fillStyle=sky;ctx.fillRect(0,0,W,H);\n ctx.fillStyle='#fff6d5';ctx.beginPath();ctx.arc(600,70,28,0,Math.PI*2);ctx.fill();\n hills(0.05,175,18,8,'#e0c193');hills(0.15,205,14,6,'#cfa96c');\n var span=1500,tr=[[120,1],[520,0.8],[900,1.15],[1250,0.9]];for(var i=0;i<tr.length;i++){var x=((tr[i][0]-off*0.4)%span+span)%span-100;acacia(x,230,tr[i][1]);}\n ctx.fillStyle='#d6b56a';ctx.fillRect(0,236,W,H-236);\n ctx.strokeStyle='#a5853d';ctx.lineWidth=2;var sp=38,st=-(off%sp);\n for(var gx=st;gx<W+sp;gx+=sp){var idx=Math.abs(Math.round((gx+off)/sp)),h=6+(idx*37%9),x2=gx+(idx*13%17),gy=252+(idx*7%4)*12;ctx.beginPath();ctx.moveTo(x2,gy);ctx.lineTo(x2-3,gy-h);ctx.moveTo(x2,gy);ctx.lineTo(x2,gy-h-2);ctx.moveTo(x2,gy);ctx.lineTo(x2+3,gy-h);ctx.stroke();}\n var cx=320;\n if(cur.px>400&&Math.random()<dt*40)dust.push({x:cx-50+Math.random()*90,y:238,r:3+Math.random()*4,l:0.6});\n for(var di=dust.length-1;di>=0;di--){var p=dust[di];p.x-=cur.px*dt*0.6;p.y-=12*dt;p.l-=dt;if(p.l<=0){dust.splice(di,1);continue;}ctx.fillStyle='rgba(160,130,80,'+(p.l*0.8)+')';ctx.beginPath();ctx.arc(p.x,p.y,p.r*(1.6-p.l),0,Math.PI*2);ctx.fill();}\n ctx.fillStyle='rgba(0,0,0,0.15)';ctx.beginPath();ctx.ellipse(cx,241,75,6,0,0,Math.PI*2);ctx.fill();\n var a=cur.amp,by=187-cur.bob*Math.abs(Math.sin(ph)),fl=(a-0.35)*12*Math.sin(ph),shX=40+fl,hpX=-40-fl,rx=56+fl;\n ctx.save();ctx.translate(cx,by);\n drawLeg(false,0.6,a,shX,hpX,'#b8892f',10);drawLeg(true,Math.PI+0.6,a,shX,hpX,'#b8892f',9);\n var tw=Math.sin(ph*0.5)*8;ctx.strokeStyle='#d9a843';ctx.lineWidth=6;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(hpX-10,-6);ctx.quadraticCurveTo(hpX-55,-24+tw,hpX-88,-2+tw*1.6);ctx.stroke();\n ctx.fillStyle='#222';ctx.beginPath();ctx.arc(hpX-88,-2+tw*1.6,4,0,Math.PI*2);ctx.fill();\n ctx.fillStyle='#e0ae4c';ctx.beginPath();ctx.ellipse(0,0,rx,18,0,0,Math.PI*2);ctx.fill();\n ctx.save();ctx.beginPath();ctx.ellipse(0,0,rx,18,0,0,Math.PI*2);ctx.clip();\n ctx.fillStyle='#f3dca5';ctx.beginPath();ctx.ellipse(0,12,rx-8,9,0,0,Math.PI*2);ctx.fill();\n ctx.fillStyle='#2b2118';for(var si=0;si<spots.length;si++){ctx.beginPath();ctx.arc(spots[si][0]*rx/56,spots[si][1],spots[si][2],0,Math.PI*2);ctx.fill();}\n ctx.restore();\n ctx.fillStyle='#e0ae4c';ctx.beginPath();ctx.ellipse(shX+12,-8,20,15,-0.4,0,Math.PI*2);ctx.fill();\n ctx.beginPath();ctx.arc(shX+38,-22,14,0,Math.PI*2);ctx.fill();\n ctx.fillStyle='#c99636';ctx.beginPath();ctx.moveTo(shX+29,-32);ctx.lineTo(shX+32,-44);ctx.lineTo(shX+39,-34);ctx.closePath();ctx.fill();\n ctx.fillStyle='#f3dca5';ctx.beginPath();ctx.ellipse(shX+49,-17,9,7,0,0,Math.PI*2);ctx.fill();\n ctx.fillStyle='#222';ctx.beginPath();ctx.arc(shX+43,-25,2.2,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(shX+57,-19,2.5,0,Math.PI*2);ctx.fill();\n ctx.strokeStyle='#222';ctx.lineWidth=1.8;ctx.beginPath();ctx.moveTo(shX+43,-23);ctx.quadraticCurveTo(shX+43,-16,shX+48,-11);ctx.stroke();\n drawLeg(false,0,a,shX,hpX,'#d9a843',11);drawLeg(true,Math.PI,a,shX,hpX,'#d9a843',9);\n ctx.restore();\n ctx.fillStyle='rgba(255,255,255,0.8)';ctx.fillRect(12,12,200,50);\n ctx.fillStyle='#333';ctx.font='bold 14px system-ui,sans-serif';ctx.fillText('Velocidade ≈ '+Math.round(cur.kmh)+' km/h',22,32);\n ctx.font='11px system-ui,sans-serif';ctx.fillText('Fôlego',22,50);ctx.fillStyle='#ddd';ctx.fillRect(70,42,130,9);\n ctx.fillStyle=stamina>0.3?'#4a9a3c':'#d0452f';ctx.fillRect(70,42,130*stamina,9);\n requestAnimationFrame(frame);\n}\nrequestAnimationFrame(frame);\n})();\n</script>"
